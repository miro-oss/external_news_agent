# Search providers
# NAVER API HUB: Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
TAVILY_API_KEY=
SERPAPI_API_KEY=

# LLM providers
GEMINI_API_KEY=
GEMINI_MODEL=
MINDLOGIC_API_KEY=
MINDLOGIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
MINDLOGIC_CLAUDE_MODEL=

# Internal analysis agent (disabled unless both enabled and authenticated)
AGENT_ENABLED=false
AGENT_BASE_URL=http://127.0.0.1:8088
AGENT_SHARED_SECRET=
AGENT_MOCK=true
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=8088
AGENT_MAX_BODY_CHARS=20000
AGENT_MAX_SENTENCES=200
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_PROVIDER_TIMEOUT_SECONDS=30
AGENT_REPORT_MAX_OUTPUT_TOKENS=8192
AGENT_REPORT_PROVIDER_TIMEOUT_SECONDS=120
# 구조화 출력 검증 실패 시 허용하는 복구 호출 횟수(현재 계약은 최대 1회)
AGENT_SCHEMA_REPAIR_ATTEMPTS=1

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=news-agent@local.test
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional Naver SMTP values for switching away from Mailpit
NAVER_SMTP_HOST=smtp.naver.com
NAVER_SMTP_PORT=465
NAVER_SMTP_FROM=
NAVER_SMTP_USERNAME=
NAVER_SMTP_PASSWORD=

# Oracle database
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
SPRING_DATASOURCE_USERNAME=news_agent
SPRING_DATASOURCE_PASSWORD=

# Search providers
# NAVER API HUB: Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# LLM providers: 기존 FREE 플랜은 OpenAI 저비용 경로입니다(API 사용량에 따라 과금).
# 실제 호출: OPENAI_API_KEY 입력, AGENT_ENABLED=true, AGENT_MOCK=false,
# BE와 agent에 같은 AGENT_SHARED_SECRET 및 아래 모델 설정을 적용 후 둘 다 재시작.
# 기존 GEMINI_API_KEY / GEMINI_MODEL / GEMINI_REQUEST_INTERVAL_SECONDS는 사용하지 않습니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
# gpt-4o-mini로도 변경 가능. 위 두 모델은 input/cached input/output 단가를 자동 적용합니다.
# costUsd는 토큰 기반 예상 USD입니다. 다른 모델/단가를 쓰면 세 줄을 함께 설정하세요.
# OPENAI_INPUT_COST_PER_MILLION=0.10
# OPENAI_CACHED_INPUT_COST_PER_MILLION=0.025
# OPENAI_OUTPUT_COST_PER_MILLION=0.40
# 주제 적합성 FREE 전용 모델. 일반 분석의 OPENAI_MODEL과 독립적이며 기본값은 gpt-4.1-nano입니다.
# Agent의 실제 모델과 BE의 판정 캐시를 맞추기 위해 BE와 agent에 같은 값을 적용하세요.
TOPIC_RELEVANCE_OPENAI_MODEL=gpt-4.1-nano
MINDLOGIC_API_KEY=
MINDLOGIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
MINDLOGIC_CLAUDE_MODEL=

# Internal analysis agent (disabled unless both enabled and authenticated)
AGENT_ENABLED=false
AGENT_BASE_URL=http://127.0.0.1:8088
AGENT_SHARED_SECRET=
AGENT_ANALYZE_TIMEOUT=90s
AGENT_INSIGHT_TIMEOUT=75s
# BE 리포트 인사이트 대기 시간은 Agent 최대 기한 180초보다 30초 이상 길어야 한다(최소 210초).
AGENT_REPORT_INSIGHT_TIMEOUT=210s
AGENT_MOCK=true
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=8088
AGENT_MAX_BODY_CHARS=20000
AGENT_MAX_SENTENCES=200
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_PROVIDER_TIMEOUT_SECONDS=30
AGENT_PROVIDER_RETRY_ATTEMPTS=1
OPENAI_REQUEST_INTERVAL_SECONDS=1
AGENT_RATE_LIMIT_RETRY_ATTEMPTS=2
AGENT_RATE_LIMIT_BACKOFF_SECONDS=4
AGENT_RATE_LIMIT_MAX_BACKOFF_SECONDS=10
# provider가 retryDelay로 알려준 대기 시간에만 적용하는 상한. 추측 backoff와 분리한다.
AGENT_RATE_LIMIT_MAX_WAIT_SECONDS=60
AGENT_PROVIDER_CONCURRENCY=4
AGENT_PROVIDER_ACQUIRE_TIMEOUT_SECONDS=1
AGENT_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_CIRCUIT_COOLDOWN_SECONDS=30
AGENT_HARD_CAP_CREDITS_PER_REQUEST=5
AGENT_ANALYSIS_PROMPT_VERSION=analyze.ko.v6+perspective.ko.v1+sensitivity.ko.v2
AGENT_INSIGHT_PROMPT_VERSION=insight.ko.v2+perspective.ko.v1
MINDLOGIC_CREDITS_PER_REQUEST=1
AGENT_INSIGHT_MAX_OUTPUT_TOKENS=8192
AGENT_INSIGHT_PROVIDER_TIMEOUT_SECONDS=60
AGENT_REPORT_MAX_OUTPUT_TOKENS=8192
# 일반 리포트 provider 기한. 관점 인사이트의 전체 기한과 별개다.
AGENT_REPORT_PROVIDER_TIMEOUT_SECONDS=120
# 관점 인사이트 MAP/REVIEW/REDUCE/복구 전체 기한(최대 180초). BE 응답 대기는 위 210초 설정을 사용한다.
AGENT_REPORT_INSIGHT_TIMEOUT_SECONDS=180
# 원문 관계 추출은 별도 평가/준비 단계에서 수행하며 HTTP 요청에서는 원문 위치·형식을 검사한 캐시만 읽는다.
# 디렉터리 미지정 시 agent/.cache/report-insight/source-relations 사용, 빈 값이면 사용하지 않는다.
# AGENT_REPORT_INSIGHT_SOURCE_CACHE_DIR=/absolute/path/to/source-relations
AGENT_REPORT_INSIGHT_SOURCE_EXTRACTION_MODEL=gpt-5-mini
# 구조화 출력 검증 실패 시 허용하는 복구 호출 횟수(현재 계약은 최대 1회)
AGENT_SCHEMA_REPAIR_ATTEMPTS=1
AGENT_EVIDENCE_GROUNDED_OVERLAP=0.6
AGENT_EVIDENCE_WEAK_OVERLAP=0.2
AGENT_EVIDENCE_MAX_CLAIM_CHARS=2000
AGENT_EVIDENCE_MAX_SENTENCES=50
AGENT_EVIDENCE_MAX_TOTAL_CHARS=40000

# Optional notifications
BREAKING_NOTIFICATION_GROUP_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Gmail SMTP (NewInsight)
# Google 계정에서 2단계 인증을 켠 뒤 https://myaccount.google.com/apppasswords 에서 앱 비밀번호를 발급하세요.
# SMTP_USERNAME: 발송에 사용할 Gmail 전체 주소. SMTP_PASSWORD: 일반 로그인 비밀번호가 아닌 16자리 앱 비밀번호.
# 조직 계정/고급 보호 등 계정 정책에 따라 앱 비밀번호 발급이 제한될 수 있습니다.
# 현재 발송기는 사용자명/비밀번호 인증을 사용하며 Google OAuth 로그인은 지원하지 않습니다.
#
# host, port, from, ssl, startTls는 환경변수가 아닌 메일 채널의 DB 설정입니다.
# GET /api/notifications/channels 에서 EMAIL 채널 ID를 확인한 뒤
# PATCH /api/notifications/channels/{channelId} 에 다음 본문을 적용하세요.
# your-account@gmail.com은 SMTP_USERNAME에 넣은 실제 발송 주소로 바꾸세요.
# {"config":{"host":"smtp.gmail.com","port":587,"from":"NewInsight <your-account@gmail.com>","ssl":false,"startTls":true}}
# SMTP_USERNAME/PASSWORD만 바꾸면 기존 SMTP 서버/발신 주소는 그대로 남습니다.
# 일반 Gmail을 쓰면 발신 주소도 @gmail.com이며, 기존 회사 도메인이 자동으로 유지되지는 않습니다.
#
# 실제 자격 증명은 서버 환경변수 또는 로컬 .env에만 넣고 예시 파일/채널 JSON에는 넣지 마세요.
# 로컬 .env는 Java properties로 읽습니다. 값에 따옴표를 붙이지 말고 앱 비밀번호는 공백 없이 입력하세요.
# 자격 증명 변경 후 백엔드를 재시작하세요. 설정 저장만으로 인증/수신 성공이 확인되지는 않습니다.
SMTP_USERNAME=
SMTP_PASSWORD=

# Recipient feedback links use the frontend origin (for example https://news.example.com).
# Leave empty to omit external report/feedback links. This is a public URL, not a credential.
NOTIFICATION_PUBLIC_BASE_URL=
FEEDBACK_ENABLED=true

# Oracle database
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
SPRING_DATASOURCE_USERNAME=news_agent
SPRING_DATASOURCE_PASSWORD=
